# Copy to .env. Values below work for local docker compose.
DATABASE_URL=postgresql://mousetrap:mousetrap@postgres:5432/mousetrap
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
ML_URL=http://ml:8000
ML_INTERNAL_KEY=change-me-internal-key
POLICY_THRESHOLDS_JSON=
DEMO_MODE=true

# Demo host (deploy/deploy.sh fills these): public hostname for Caddy, and trust its X-Forwarded-For.
# Locally leave TRUST_PROXY=false so the socket address is used and clients cannot spoof their IP.
DOMAIN=localhost
TRUST_PROXY=false

# Optional (stretch)
HF_TOKEN=
HF_MODEL_REPO=
LLM_API_URL=
LLM_API_KEY=
